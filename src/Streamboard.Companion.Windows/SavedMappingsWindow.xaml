<Window x:Class="Streamboard.Companion.Windows.SavedMappingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Сохранённые сопоставления" Icon="Assets/Streamboard.ico"
        Width="800" Height="520" MinWidth="580" MinHeight="320"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,12" LastChildFill="True">
      <Button x:Name="RefreshButton" DockPanel.Dock="Right" Padding="12,6" Margin="12,0,0,0"
              Content="Обновить" Click="RefreshButton_Click" />
      <TextBlock VerticalAlignment="Center" FontSize="20" FontWeight="SemiBold"
                 Text="Сохранённые сопоставления" />
    </DockPanel>
    <DataGrid x:Name="MappingsGrid" Grid.Row="1" AutomationProperties.Name="Сохранённые сопоставления"
              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
              CanUserSortColumns="False" SelectionMode="Single" HeadersVisibility="Column">
      <DataGrid.Columns>
        <DataGridTemplateColumn Header="Игра / EXE" Width="1.3*" MinWidth="170">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Margin="8,5" ToolTip="{Binding Game.DisplayName}">
                <TextBlock Text="{Binding Game.DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding Game.ExecutableName}" TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Game.ExecutableName}" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Twitch" Width="*" MinWidth="140">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Margin="4" Padding="7,4" HorizontalContentAlignment="Left"
                      AutomationProperties.Name="{Binding TwitchLabel, StringFormat='Twitch: {0}'}"
                      ToolTip="{Binding TwitchLabel}" Click="TwitchCategory_Click">
                <TextBlock Text="{Binding TwitchLabel}" TextTrimming="CharacterEllipsis" />
              </Button>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="VK Play Live" Width="*" MinWidth="140">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <Button Margin="4" Padding="7,4" HorizontalContentAlignment="Left"
                      AutomationProperties.Name="{Binding VkPlayLiveLabel, StringFormat='VK Play Live: {0}'}"
                      ToolTip="{Binding VkPlayLiveLabel}" Click="VkCategory_Click">
                <TextBlock Text="{Binding VkPlayLiveLabel}" TextTrimming="CharacterEllipsis" />
              </Button>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock x:Name="FeedbackText" Grid.Row="2" Margin="0,10,0,0" TextWrapping="Wrap"
               AutomationProperties.LiveSetting="Polite" />
  </Grid>
</Window>
