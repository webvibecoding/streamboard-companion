<Window x:Class="Streamboard.Companion.Windows.CategoryMappingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор категории" Height="520" Width="620"
        MinHeight="460" MinWidth="540" WindowStartupLocation="CenterOwner">
  <Grid Margin="22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel>
      <TextBlock Text="Сопоставление игры" FontSize="22" FontWeight="Bold" />
      <TextBlock Margin="0,6,0,0" Foreground="#666" Text="Категория сохраняется отдельно для каждой платформы." />
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,18,0,0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="110" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock VerticalAlignment="Center" Text="Название игры" />
      <TextBox x:Name="GameNameBox" Grid.Column="1" Padding="8" MaxLength="200" />
    </Grid>

    <Grid Grid.Row="2" Margin="0,12,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="150" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ComboBox x:Name="PlatformBox" Padding="8" SelectedIndex="0">
        <ComboBoxItem Tag="twitch" Content="Twitch" />
        <ComboBoxItem Tag="vkplaylive" Content="VK Play Live" />
      </ComboBox>
      <TextBox x:Name="QueryBox" Grid.Column="1" Margin="10,0" Padding="8" MaxLength="140" />
      <Button x:Name="SearchButton" Grid.Column="2" Padding="16,8" Content="Найти" Click="SearchButton_Click" />
    </Grid>

    <ListBox x:Name="ResultsList" Grid.Row="3" DisplayMemberPath="Name" />

    <Grid Grid.Row="4" Margin="0,14,0,0">
      <TextBlock x:Name="FeedbackText" VerticalAlignment="Center" Foreground="#666" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Padding="14,8" Margin="0,0,8,0" Content="Отмена" Click="CancelButton_Click" />
        <Button x:Name="SaveButton" Padding="14,8" Content="Сохранить" IsEnabled="False" Click="SaveButton_Click" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
